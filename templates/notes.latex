\documentclass[11pt,a4paper]{article}
\usepackage{notes}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
$if(highlighting-macros)$
$highlighting-macros$
$endif$
$if(tables)$
\usepackage{longtable,booktabs,array,calc}
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother
\newcounter{none}
$if(is_program)$
% программа курса (program/<course>.md): таблицы весов и тем — мельче и с воздухом между строками
\renewcommand{\arraystretch}{1.3}
\AtBeginEnvironment{longtable}{\small}
\setlength{\LTpre}{0.9em}
\setlength{\LTpost}{0.9em}
$endif$
$endif$
\usepackage{graphicx}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi}
\makeatother
$if(strikeout)$
\usepackage{soul}
$endif$

% метаданные конспекта (шапка, markup.md §1)
\course{$course$}
\coursename{$course_name$}
$if(lecture)$
\lecturenumber{$lecture$}
$endif$
$if(date)$
\lecturedate{$date$}
$endif$
\notestitle{$notes_title$}
\nbheaderline{$header_line$}
\hypersetup{pdftitle={$notes_title$}, pdfauthor={$program$}, pdflang={ru}}

\begin{document}
\nbmaketitle{$notes_title$}

$body$

\end{document}
