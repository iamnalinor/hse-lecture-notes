{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "src/index.ts",
    "preview/src/index.ts",
    "scripts/*.ts",
    "integration/*.mjs",
    "*.config.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/*.ts",
    "tests/**/*.ts",
    "preview/**/*.ts",
    "integration/*.mjs"
  ]
}
