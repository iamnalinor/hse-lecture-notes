{
  "name": "hse-lecture-notes-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "admin": "bun run scripts/admin.ts",
    "lint": "bun run lint:format && bun run lint:eslint && bun run typecheck && bun run lint:knip",
    "lint:format": "biome format --write .",
    "lint:eslint": "eslint . --max-warnings 0 --cache --cache-location .cache/eslint/ --fix",
    "lint:knip": "knip --no-progress"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261123.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "jiti": "2.7.0",
    "knip": "6.44.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.167.0"
  },
  "dependencies": {
    "subtls": "^0.5.0"
  }
}
