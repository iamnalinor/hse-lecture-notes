{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": ["scripts/*.ts", "*.config.ts", "sw/service-worker.ts"],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.ts", "sw/*.ts"],
  // Types picked up by TypeScript implicitly (katex ships no types of its own).
  "ignoreDependencies": ["@types/katex"]
}
